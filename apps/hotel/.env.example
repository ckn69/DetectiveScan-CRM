# Espace hôtelier — variables d'environnement
#
# Étape 1 : aucune variable n'est nécessaire. Sans Supabase, l'application
# tourne en MODE DÉMO (données fictives « Hôtel Démo », bouton « Explorer la démo »).
#
# Étape « comptes réels » : renseigner ces deux valeurs dans Vercel
# (Project Settings → Environment Variables), jamais dans le code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
